# ── App ──────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
FRONTEND_URL=http://localhost:5173

# ── Google OAuth ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── JWT ──────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./printshop.db

# ── File Upload ───────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,svg
UPLOADS_DIR=uploads

# ── ClamAV ───────────────────────────────────────────────────────────
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ── Gmail SMTP ───────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_NAME=PrintShop

# ── Admin ────────────────────────────────────────────────────────────
ADMIN_APPROVAL_EMAIL=admin@yourdomain.com
ADMIN_APPROVAL_TOKEN_EXPIRE_HOURS=1

# ── WhatsApp ─────────────────────────────────────────────────────────
WHATSAPP_PROVIDER=stub
WHATSAPP_NOTIFICATION_MOBILE=+919999999999

# Meta WhatsApp Cloud API
WHATSAPP_META_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_META_ACCESS_TOKEN=your-whatsapp-access-token

# Twilio WhatsApp Sandbox (dev)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
